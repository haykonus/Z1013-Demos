  407/ 398 :                            
  408/ 398 :                            ; ------------------------------------------------------------
  409/ 398 :                            ; 8-connected LINE (Bresenham)
  410/ 398 :                            ; Gut für ASCII-Grafik, da hier möglichst schmale Linien 
  411/ 398 :                            ; gezeichnet werden sollen. Jedes Pixel hat 8 Nachbarn, 
  412/ 398 :                            ; die alle als Schrittrichtung erlaubt sind.
  413/ 398 :                            ;
  414/ 398 :                            ; Linie von DE -> nach HL
  415/ 398 :                            ;
  416/ 398 :                            ; In:   D = Start-Y, E = Start-X
  417/ 398 :                            ;       H = Ziel-Y,  L = Ziel-X
  418/ 398 :                            ;       
  419/ 398 :                            ; Out:  ASCII-Linie im BWS
  420/ 398 :                            ; ------------------------------------------------------------
  421/ 398 :                            
